{
  "typeCheckingMode": "basic",
  "include": [
    "src"
  ],
  "extraPaths": [
    "src"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/venv",
    "**/.venv"
  ],
  "reportMissingImports": true,
  "venvPath": ".",
  "venv": "venv",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux"
}
